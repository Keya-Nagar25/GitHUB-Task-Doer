# Copy this file to backend/.env and fill in the values you need.
# backend/.env is gitignored -- never commit real secrets.

# GitHub OAuth App (GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App)
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:8000/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Keeps you logged in across backend restarts. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=

# Optional: enables the online (Claude API) fallback for phrasing the offline classifier doesn't recognise.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# WEB_APP_URL=http://localhost:5173
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
